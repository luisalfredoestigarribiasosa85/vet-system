# Servidor
PORT=5000
NODE_ENV=development

# Base de datos PostgreSQL
# Si se define DATABASE_URL tiene prioridad sobre las variables DB_*
# DATABASE_URL=postgres://usuario:password@localhost:5432/vet_system
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vet_system
DB_USER=vet_admin
DB_PASSWORD=tu_password

# JWT
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar_por_una_cadena_larga_y_aleatoria
JWT_EXPIRE=7d

# URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Email (opcional, solo para notificaciones)
# Con Gmail usar una App Password: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

# Pagos (opcional, solo para suscripciones)
# Valores posibles: pagopar | stripe | payu
PAYMENT_PROVIDER=pagopar

# PagoPar
PAGOPAR_TOKEN=
PAGOPAR_PUBLIC_KEY=
PAGOPAR_PRIVATE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayU
PAYU_API_KEY=
PAYU_API_LOGIN=
PAYU_MERCHANT_ID=
PAYU_ACCOUNT_ID=
